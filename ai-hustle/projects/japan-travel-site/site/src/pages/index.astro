---
import Base from '../layouts/Base.astro';
import { SITE_NAME, SITE_DESC, SITE_TAGLINE, DESTINATIONS } from '../site';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, alternateName: SITE_TAGLINE, url: Astro.site?.href, inLanguage: 'zh-Hant-TW', description: SITE_DESC,
}];
---
<Base title={SITE_NAME} jsonLd={jsonLd}>
  <h1>走啊，敢不敢？<br />出發前先算一下。</h1>
  <p class="lead">{SITE_TAGLINE}。票價、規定、日期都附來源與查核日期，查不到的寫「待確認」，不用估計值充數。</p>

  <h2>選目的地</h2>
  <div class="cards">
    {DESTINATIONS.map((d) => d.status === 'live' ? (
      <a class="card" href={d.path!} style="text-decoration:none;color:inherit">
        <h3>{d.emoji} {d.name}</h3><p class="meta">{d.desc}</p><span class="btn">進入 →</span>
      </a>
    ) : (
      <div class="card soon" aria-disabled="true"><h3>{d.emoji} {d.name}</h3><p class="meta">即將推出</p></div>
    ))}
  </div>

  <h2>日本熱門工具</h2>
  <ul>
    <li><a href="/japan/tools/jr-pass-calculator/">JR Pass／周遊券划算試算器</a></li>
    <li><a href="/japan/tools/japan-tax-refund/">日本退稅試算（2026/11/1 新制）</a></li>
    <li><a href="/japan/tools/japan-trip-budget/">日本旅遊預算計算機</a></li>
    <li><a href="/japan/sakura/2027/">2027 櫻花季時程表與日期速查</a></li>
  </ul>

  <h2>本站原則</h2>
  <ul>
    <li>每個價格、日期都附來源連結與查核日期。</li>
    <li>查不到的寫「待確認」，不用估計值充數。</li>
    <li>二手來源會標示出來，提醒你購買前到官方網站核對。</li>
  </ul>
</Base>
